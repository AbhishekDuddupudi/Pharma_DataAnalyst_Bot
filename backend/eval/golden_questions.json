    {
      "id": "chain_01",
      "name": "Revenue drill-down: all → quarter → region",
      "type": "chain",
      "turns": [
        "Top 5 products by revenue in 2024",
        "Same for last quarter",
        "Now filter that to Northeast"
      ],
      "expect": {
        "should_reuse_intent": true,
        "must_apply_filter": {"field": "region", "value": "Northeast"},
        "min_tasks_each_turn": [1, 1, 1],
        "answer_must_not_contain": ["SELECT", "FROM", "JOIN", "###", "**", "```"]
      }
    },
    {
      "id": "chain_02",
      "name": "Cardivex Northeast → monthly breakdown",
      "type": "chain",
      "turns": [
        "Cardivex sales in Northeast Q3 2024",
        "Break it down by month"
      ],
      "expect": {
        "should_reuse_intent": true,
        "min_tasks_each_turn": [1, 1],
        "answer_must_not_contain": ["SELECT", "FROM", "JOIN", "###", "**", "```"]
      }
    },
    {
      "id": "chain_03",
      "name": "Cardivex decline insight → time shift",
      "type": "chain",
      "turns": [
        "Why did Cardivex sales decline in Northeast?",
        "Show me the same for Q4 2024"
      ],
      "expect": {
        "should_reuse_intent": true,
        "min_tasks_each_turn": [1, 1],
        "answer_must_not_contain": ["SELECT", "FROM", "JOIN", "###", "**", "```"]
      }
    },
    {
      "id": "chain_04",
      "name": "Oncology overview → company focus → region filter",
      "type": "chain",
      "turns": [
        "Compare all oncology products by total revenue in 2024",
        "Focus on BioGenix Pharma products only",
        "Show that for the West region"
      ],
      "expect": {
        "should_reuse_intent": true,
        "must_apply_filter": {"field": "region", "value": "West"},
        "min_tasks_each_turn": [1, 1, 1],
        "answer_must_not_contain": ["SELECT", "FROM", "JOIN", "###", "**", "```"]
