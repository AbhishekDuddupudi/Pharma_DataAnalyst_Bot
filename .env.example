# ──────────────────────────────────────────────
# Pharma Data Analyst Bot – Environment Variables
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────

# Postgres
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma_secret
POSTGRES_DB=pharma_db
DATABASE_URL=postgresql+asyncpg://pharma:pharma_secret@db:5432/pharma_db

# OpenAI / LLM
OPENAI_API_KEY=sk-REPLACE_ME

# App
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:5173

# Owner user (used by scripts/create_owner.py)
# OWNER_EMAIL / OWNER_DISPLAY_NAME may be set to skip prompts.
# OWNER_PASSWORD is OPTIONAL and for automation/testing ONLY — leave it unset
# for normal interactive use (the script prompts with hidden input).
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Owner
# OWNER_PASSWORD=

# Langfuse Observability (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com

# ──────────────────────────────────────────────
# PRODUCTION (AWS) — override the values above on the EC2 host.
# Do NOT commit a real .env. Example production settings:
#
#   APP_ENV=production
#   LOG_LEVEL=INFO
#   # Point at AWS RDS (NOT the docker "db" host):
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@<rds-endpoint>:5432/pharma_db
#   # Your public HTTPS domain (single origin; harmless belt-and-suspenders):
#   CORS_ORIGINS=https://your-domain
#   OPENAI_API_KEY=sk-...your-real-key...
#   # Create the owner interactively after migrating the DB:
#   #   python -m scripts.create_owner
# ──────────────────────────────────────────────
